<wa-tree-item class="dir{{#navhidden}} navhidden{{/navhidden}}" hx-get="{{{hx_href}}}" hx-trigger="wa-lazy-load" hx-target="this" hx-swap="beforeend" hx-select-oob=""><span hx-get="{{{hx_href}}}" hx-trigger="click[this.parentElement.selected]"><a href="{{{hx_href}}}" tabindex="-1" draggable="false" hx-on:click="if (event.ctrlKey || event.metaKey || event.shiftKey) event.stopPropagation(); else event.preventDefault()">{{#icon_badge}}<span class="icon-badged">{{/icon_badge}}<wa-icon name="{{{icon}}}" variant="regular"></wa-icon>{{#icon_badge}}<wa-icon name="{{{icon_badge}}}" variant="solid"></wa-icon></span>{{/icon_badge}}{{{name}}}/</a></span></wa-tree-item>
