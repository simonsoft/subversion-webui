<!DOCTYPE html>
<html lang="en" class="wa-cloak">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{#has_base}}{{base}} - Revision {{rev}}: {{/has_base}}{{path}}</title>
<link rel="stylesheet" href="https://ka-f.webawesome.com/webawesome@3.12.0/styles/webawesome.css">
<script type="module" src="https://ka-f.webawesome.com/webawesome@3.12.0/webawesome.loader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0" integrity="sha384-BvJpBiO8Kh31EqtJe5DRIeWrHWnCGkwytKs9NKFi86Hhw96dEqdEMzZDeK9iEGTc" crossorigin="anonymous"></script>
<script>
// "wa-lazy-load" bubbles, and htmx's hx-trigger binds a real, permanent
// listener to each lazy tree item at the moment it's processed -- removing
// the "hx-trigger"/"lazy" *attributes* later doesn't detach that listener,
// so without this, a deeply nested item's own lazy-load event also re-fires
// every already-loaded ancestor's listener above it, re-fetching and
// re-appending duplicate children onto each of them.
//
// Fixed by injecting a one-time, self-removing stopPropagation listener
// directly onto the actual originating element (event.target) *before* the
// event reaches it: this capture-phase document listener runs first (since
// capture travels document -> ... -> target), so the listener it adds is
// already in place by the time dispatch reaches the target's own listeners.
// Because it's added to the same node, it doesn't block htmx's
// already-bound listener on that same element from firing (stopPropagation
// only stops the event moving on to the *next* node in the path) -- it only
// stops the event from then bubbling up into ancestor tree items.
document.addEventListener("wa-lazy-load", (event) => {
    event.target.addEventListener("wa-lazy-load", (e) => e.stopPropagation(), { once: true });
}, true);

// dir.mustache's wa-tree-item never sets "lazy" itself, since it's the exact
// same markup rendered into both #svn-index (main, a strictly flat listing
// -- its label already swaps main's whole content to browse deeper, one
// level at a time) and the nav tree (which does want in-place, lazy-loaded
// expansion). Nav is the one that opts in: whenever it gets newly-fetched
// dir entries -- whether at the root (the "svn-nav" branch below) or nested
// under an already-expanded item (the "lazy" branch) -- this marks them
// lazy=true so *they* become expandable in turn. Main's own copies are left
// alone entirely, so they're simply never lazy in the first place: no
// chevron, and no need for anything to suppress wa-lazy-load from firing.
//
// wa-tree-item's own "loading" state (the spinner shown while lazy) is
// separate from the "lazy" attribute -- it only clears once the item
// actually observes its children change. When the expanded directory is
// empty, hx-select matches nothing, so beforeend appends zero nodes: no
// child-list mutation ever happens, and "loading" (confirmed via aria-busy)
// is left stuck forever. Setting the "loading" property directly ends it
// regardless of whether any children actually got appended.
document.addEventListener("htmx:after:swap", (event) => {
    // Covers a directory's own content finishing loading, whether that was
    // triggered by a real chevron click (lazy="true" -> wa-lazy-load), an
    // on-path entry's own hx-trigger="load" auto-firing, or the nav tree's
    // own root-level population -- event.target is either a
    // "wa-tree-item.dir" or the "svn-nav" tree itself in every such case,
    // and both always sit inside (or, for the tree itself, at the root of)
    // ".svn-nav", so a single ancestor check covers all of them uniformly.
    // Never fires for main's own copies: their hx-trigger="wa-lazy-load"
    // never actually fires there (no chevron is ever shown, since they're
    // never marked lazy and never on-path), so this swap target never
    // occurs for them, and main's own tree doesn't carry the "svn-nav"
    // class anyway.
    if (event.target.closest?.(".svn-nav")) {
        // wa-tree-item shows its expand chevron based on actually having
        // child wa-tree-item elements, regardless of their own visibility
        // -- but the nav tree only ever wants to browse folders
        // (files/updir are hidden via CSS, see wa-tree.svn-nav
        // .file/.updir above), so a folder containing only files (or
        // nothing at all) would otherwise still show a chevron that
        // reveals nothing when clicked.
        event.target.querySelectorAll(":scope > wa-tree-item:not(.dir)").forEach((child) => child.remove());

        // hx-trigger="load" is dir.mustache's own is_target_any marker (set
        // server-side; see ENTRY_CONTEXT_BUILDERS.dir) -- reading it back
        // here, rather than templating a separate "expanded" attribute
        // too, keeps that expressed in exactly one place. Either way this
        // sets "expanded"/"lazy" as a real JS property, never relying on a
        // static HTML attribute alone: confirmed via a real browser that
        // an "expanded" attribute present in the server-rendered markup
        // itself can still end up visually collapsed somewhere in this
        // actual htmx-driven insert-then-self-fetch flow (not
        // reproducible from a plain, non-htmx element in isolation).
        // "selected" marks dir.mustache's own is_target_leaf match (see
        // ENTRY_CONTEXT_BUILDERS.dir) -- unlike "expanded" above, the
        // static attribute alone renders correctly here, confirmed via a
        // real browser, so it needs no JS re-assertion.
        const dirChildren = event.target.querySelectorAll(":scope > wa-tree-item.dir");
        dirChildren.forEach((child) => {
            if (child.getAttribute("hx-trigger") === "load") {
                child.expanded = true;
            } else {
                child.lazy = true;
            }
        });

        // "lazy"/"loading"/"isLeaf" are only meaningful on a wa-tree-item
        // itself, not on the root <wa-tree> (the "svn-nav" branch of this
        // same check, i.e. the tree's own initial population) --
        // wa-tree-item's own "loading" state (the spinner shown while
        // lazy) is separate from the "lazy" attribute and only clears once
        // the item actually observes its children change; when the
        // expanded directory is empty, hx-select matches nothing, so
        // beforeend appends zero nodes and "loading" (confirmed via
        // aria-busy) would otherwise be left stuck forever. Setting
        // "loading"/"isLeaf" directly, as real settable properties rather
        // than just computed ones, covers both regardless of whether
        // anything was actually appended.
        if (event.target.matches?.("wa-tree-item.dir")) {
            event.target.removeAttribute("lazy");
            event.target.loading = false;
            event.target.isLeaf = dirChildren.length === 0;
        }
    }
});

// The History link's REPORT response (see svn-log.lua's output_filter)
// swaps into "#svn-history-content", a permanently-present, initially-empty
// div inside the static "#svn-history-dialog" -- opening the dialog here,
// once the swap actually lands, rather than synchronously on click, means
// it stays closed if the request errors out instead of popping up empty.
// Re-opening (clicking History again while already viewing an older
// result) is harmless: "open = true" on an already-open wa-dialog is a
// no-op, confirmed against a real browser.
//
// Deliberately NOT event.target: htmx's own source
// (__trigger(ctx.sourceElement, "htmx:after:swap", {ctx})) dispatches this
// event ON THE REQUEST'S SOURCE ELEMENT (here, the History link itself),
// not the swap target -- and since it bubbles, event.target stays that
// source element throughout, never becoming "#svn-history-content". The
// resolved swap target is instead reachable at event.detail.ctx.target
// (confirmed against htmx's own source: ctx.target is reassigned to the
// actual resolved Element via __resolveTarget() during request setup).
document.addEventListener("htmx:after:swap", (event) => {
    if (event.detail.ctx.target?.id === "svn-history-content") {
        document.getElementById("svn-history-dialog").open = true;

        // Every fresh History fetch re-renders entries collapsed (no
        // "open" attribute -- see log-item.mustache) regardless of
        // whatever expand/collapse state was left over from a previous
        // view of this same dialog, so the toggle's own label is reset
        // here to match.
        setHistoryExpandToggleLabel(false);
    }
});

// A continuous-scroll append (see log-more.mustache's own sentinel,
// swapped via hx-target="this" hx-swap="outerHTML") only ever replaces
// itself with a fresh batch of COLLAPSED entries (log-item.mustache never
// renders "open") plus, possibly, a new sentinel for the next batch --
// never touching any already-rendered entry's own "open" state. So unlike
// the full-dialog-swap case above, the toggle's label is never reset here
// -- only re-derived from current reality, via the exact same
// wa-show/wa-hide-driven sync used for manual per-entry toggling
// (scheduleHistoryExpandToggleLabelSync, below): if the label already read
// "Collapse all" before this append, the newly-appended (collapsed)
// entries mean that's no longer true, and this is the only place that
// invariant can break without either event firing on any existing entry.
// event.detail.ctx.target is the sentinel's own (by-then-detached, since
// outerHTML already replaced it) DOM node -- still a valid object
// reference with its own classList, same as the dialog-open check above
// relies on for id.
document.addEventListener("htmx:after:swap", (event) => {
    if (event.detail.ctx.target?.classList?.contains("svn-log-more")) {
        scheduleHistoryExpandToggleLabelSync();
    }
});

// Nav's own [selected] wa-tree-item is only a one-time snapshot, taken
// when nav rendered that item itself (root population or lazy-expansion,
// both hx-target="this" -- see the ".svn-nav" branch above). Clicking a
// folder's label *within nav* already keeps selection correct on its own,
// via wa-tree's own built-in single-selection behavior -- but main's label
// clicks and breadcrumb clicks both swap "#svn-index" instead, without
// ever touching nav, so nav's stale snapshot is never told the current
// directory changed.
//
// This can't key off "htmx:after:swap"'s own event.target: htmx dispatches
// that event on the request's source element only if it's still connected
// to the DOM at dispatch time, falling back to `document` otherwise
// (confirmed via htmx's own source) -- and for both cases above, the
// clicked element sits inside whatever this very swap (or its
// accompanying "#svn-breadcrumb" oob swap) just replaced, so it's already
// disconnected by dispatch time and event.target is just `document`,
// unrelated to "#svn-index" or nav either way. "htmx:after:history:push"
// sidesteps that entirely: htmx dispatches it on `document`, unconditionally,
// exactly when it performs history.pushState() -- i.e. only when the
// response actually carried HX-Push-Url (svn-index.lua never sends
// HX-Replace-Url, so "push" is the only variant this app produces), with
// the exact destination path already provided, no response-header parsing
// needed. That also means no extra condition is needed here: nav's own
// root/lazy-expansion fetches never receive HX-Push-Url and so never
// trigger this at all.
document.addEventListener("htmx:after:history:push", (event) => {
    const pushedPath = event.detail?.path;

    if (!pushedPath) {
        return;
    }

    // Cleared via querySelectorAll rather than assuming exactly one stale
    // match, for the same reason every other cleanup in this file does.
    document.querySelectorAll(".svn-nav wa-tree-item.dir[selected]").forEach((item) => {
        item.selected = false;
    });

    // A plain per-element attribute comparison, not a dynamically-built
    // CSS attribute-selector string, since pushedPath can contain
    // arbitrary percent-encoded/Unicode segments that would need escaping
    // for selector syntax (see request_href/hx_href in svn-index.lua).
    const matched = [...document.querySelectorAll(".svn-nav wa-tree-item.dir[hx-get]")]
        .find((item) => item.getAttribute("hx-get") === pushedPath);

    // No match just means the destination was never fetched/expanded in
    // nav (off the original auto-expand-on-load path) -- nav and main stay
    // only loosely coupled after initial load by design, so this leaves no
    // selection at all rather than forcing a new fetch/expand to reveal it.
    if (matched) {
        matched.selected = true;
    }
});

// "Expand all"/"Collapse all" toggle for the History dialog's own entries
// (see page.mustache's static "#svn-history-expand-toggle", inside
// "#svn-history-dialog"'s own header-actions slot -- present in the DOM from
// initial page load, unlike the entries themselves, which are swapped in
// fresh on every History fetch). Delegated on document, not bound
// directly: this script block runs in <head>, before <body> exists, so a
// direct getElementById(...).addEventListener(...) here would find
// nothing -- the same reason every other listener in this file is
// registered on document. Re-queries wa-details.log-item at click time
// for the same "swapped in fresh" reason -- there's no fixed set of
// elements to bind to once, up front.
document.addEventListener("click", (event) => {
    if (!event.target.closest?.("#svn-history-expand-toggle")) {
        return;
    }

    const items = document.querySelectorAll("#svn-history-content wa-details.log-item");

    // "Expand all" while any entry is still collapsed (open them all);
    // once every entry is already open, the same click collapses them
    // all back down -- a stateful toggle, not a one-shot action. Doesn't
    // set the label itself -- see the "wa-show"/"wa-hide" listeners below,
    // which this bulk-set also drives.
    const opening = [...items].some((item) => !item.open);

    items.forEach((item) => { item.open = opening; });
});

function setHistoryExpandToggleLabel(allOpen) {
    const button = document.getElementById("svn-history-expand-toggle");

    if (button) {
        button.textContent = allOpen ? "Collapse all" : "Expand all";
    }
}

// Each <wa-details class="log-item"> is independently expandable by
// clicking its own summary directly, not just via "#svn-history-expand-
// toggle" above -- without this, manually opening/closing entries one at
// a time leaves the toggle's label stale (e.g. every entry manually
// opened, but the button still reads "Expand all", when clicking it
// would now actually collapse everything). "wa-show"/"wa-hide" (bubbles,
// composed -- confirmed against Web Awesome's own source) fire on the
// <wa-details> host itself whenever "open" changes, whether from a real
// click or a script setting the property directly (as the bulk toggle
// above does), so recomputing here covers every way an entry's state can
// change, uniformly.
//
// Deliberately deferred via requestAnimationFrame, not recomputed
// immediately on each event: a bulk toggle sets "open" on every item in
// one synchronous loop, firing one "wa-show"/"wa-hide" per item --
// reacting to each individually would mean trusting a specific firing
// order to land on the correct final state last, risking a visible
// flicker between transitional states first. requestAnimationFrame is
// guaranteed by the event-loop spec to run only after the entire
// microtask queue -- including every one of those events' own dispatch,
// however many fire and in whatever order -- has fully drained, so
// recomputing there always reads settled state. The
// "historyExpandToggleSyncScheduled" guard then collapses however many
// events fired in one burst into a single recompute rather than one per
// event.
let historyExpandToggleSyncScheduled = false;

function syncHistoryExpandToggleLabel() {
    const items = document.querySelectorAll("#svn-history-content wa-details.log-item");
    setHistoryExpandToggleLabel(items.length > 0 && [...items].every((item) => item.open));
}

function scheduleHistoryExpandToggleLabelSync() {
    if (historyExpandToggleSyncScheduled) {
        return;
    }
    historyExpandToggleSyncScheduled = true;
    requestAnimationFrame(() => {
        historyExpandToggleSyncScheduled = false;
        syncHistoryExpandToggleLabel();
    });
}

document.addEventListener("wa-show", (event) => {
    if (event.target.closest?.("#svn-history-content wa-details.log-item")) {
        scheduleHistoryExpandToggleLabelSync();
    }
});
document.addEventListener("wa-hide", (event) => {
    if (event.target.closest?.("#svn-history-content wa-details.log-item")) {
        scheduleHistoryExpandToggleLabelSync();
    }
});
</script>
<style>
wa-page {
    --menu-width: 25rem;
    /* Ramps from 0 at a 1400px viewport (the "(100vw - 1400px)" term is
       negative below that, and clamp()'s floor absorbs it down to 0rem --
       a continuous approach to zero, not a hard breakpoint snap) up to the
       30rem cap on very wide screens, acting more like a margin there. */
    --aside-width: clamp(0rem, (100vw - 1400px) * 0.4, 30rem);
}

wa-page[view='desktop'] {
    [slot*='navigation'] {
        border-inline-end: var(--wa-border-width-s) var(--wa-border-style) var(--wa-color-surface-border);
    }
    [slot='aside'] {
        border-inline-start: var(--wa-border-width-s) var(--wa-border-style) var(--wa-color-surface-border);
    }
}
wa-page[view='mobile'] {
    --menu-width: auto;
    --aside-width: auto;

    header[slot="header"] a span {
        display: none;
    }
}

/* On small screens, wa-page renders its own hamburger navigation-toggle
   button in a shadow-DOM wrapper (part="header") that sits alongside the
   light-DOM <header slot="header"> content below, slotted directly inside
   it -- confirmed via a real browser that this wrapper has no background
   or color of its own by default, leaving the toggle floating outside the
   blue header bar rather than looking like part of it. Both set once here
   rather than also on "header[slot='header']" below: "background" paints
   directly behind that slotted content anyway, and "color" is inherited
   property, so it flows down through the flattened tree into both the
   navigation-toggle button (a shadow-DOM child of this same wrapper) and
   the slotted light-DOM header content alike (confirmed via a real
   browser) -- no need to set it on either individually.
   "::part(header)" reaches the wrapper directly (it's exposed by wa-page
   itself, not nested inside a further shadow root). */
wa-page::part(header) {
    align-items: center;
    /* --svn-header-bg has no value of its own here -- only a fallback --
       so a site can override the header's background color by setting it
       from a later stylesheet (e.g. a `:root { --svn-header-bg: ...; }`
       rule in page-head-end.mustache/page-head-end.custom.mustache,
       rendered into <head> after this stylesheet block) without touching
       this file. Sets on :root (or any ancestor) reach ::part(header) the
       same way --width reaches #svn-history-dialog::part(dialog) below --
       custom properties inherit into shadow trees, unlike ordinary CSS
       properties. */
    background: var(--svn-header-bg, var(--wa-color-brand-fill-loud));
    color: var(--wa-color-neutral-fill-quiet);
}

header[slot="header"] {
    --wa-link-decoration-default: none;
    /*--wa-color-text-link: var(--wa-color-text-normal);*/
    /* Vertical padding is its own overridable custom property -- same
       fallback-only convention as "--svn-header-bg" above -- so a site can
       set `:root { --svn-header-padding-v: ...; }` from
       page-head-end.mustache without touching this file. */
    padding-inline: var(--wa-space-m);
    padding-block: var(--svn-header-padding-v, var(--wa-space-s));
    /* Web Awesome's own base stylesheet gives semantic elements like
       <header> an opaque default background (confirmed via a real browser
       -- not visible in this file's own CSSOM introspection, since that
       stylesheet is cross-origin) -- overridden explicitly here so the
       actual blue shows through from "wa-page::part(header)" behind it,
       the one place both background and text color are actually defined
       (this element's own "color" is inherited from there, see the comment
       above that rule). */
    background: transparent;
    /* wa-split/wa-cluster default to flex-wrap: wrap with no overflow
       handling, so once combined content (hamburger + Start/Up/History +
       whatever a site adds to #svn-header-right, which is explicitly meant
       to be extensible) exceeds the available width, it used to wrap onto
       a second line inside this bar. nowrap + a scrollbar keeps it to one
       row on any screen size instead -- mobile additionally hides the link
       labels below, in the wa-page[view='mobile'] block above, since a
       phone-width row rarely has room for a scrollbar to be discoverable
       either. */
    flex-wrap: nowrap;
    overflow-x: auto;
}

header[slot="header"] .wa-cluster {
    flex-wrap: nowrap;
}

header[slot="header"] a {
    display: inline-flex;
    align-items: center;
    gap: var(--wa-space-2xs);
    color: inherit;
    font-weight: var(--wa-font-weight-action);
}

nav[slot="subheader"] {
    padding-inline: var(--wa-space-l);
    padding-block: var(--svn-subheader-padding-v, var(--wa-space-m));
    border-block-end: var(--wa-border-width-s) var(--wa-border-style) var(--wa-color-surface-border);
}

/* "Display the revision to the right of the breadcrumbs in a square
   (non-rounded but dashed)" -- shown only while actively pinned to a past
   revision via "?p=REV" (see "revision_pinned" in template_context()),
   never for ordinary HEAD browsing. */
.revision-badge {
    border: var(--wa-border-width-s) dashed var(--wa-color-surface-border);
    border-radius: 0;
    padding: 0 var(--wa-space-2xs);
}

/* Pure-CSS show/hide, no JS: wa-switch exposes its checked state via the
   standard custom-element-internals ":state()" pseudo-class (confirmed via
   a real browser -- unlike its "checked" *attribute*, which does NOT
   reflect back when toggled by a user click, only on initial render), so
   "#svn-subheader:has(...)" can react live to the switch without any
   listener at all. ".svn-main" is #svn-subheader's own sibling (both direct
   children of <wa-page>), so the general sibling combinator reaches it
   directly. */
#svn-subheader:has(wa-switch:not(:state(checked))) ~ .svn-main .dir {
    display: none;
}

footer[slot="footer"] {
    padding: var(--wa-space-xs);
    border-block-start: var(--wa-border-width-s) var(--wa-border-style) var(--wa-color-surface-border);
}

/* Matches the padding wa-page already applies to the navigation slot, so
   the main listing doesn't sit flush against the edge while nav has room. */
div.svn-main {
    padding: var(--wa-space-m);
}

/* "#svn-history-dialog" itself sizes to fit its content by default -- fixed
   here (on the content div, not the dialog; a real "height", not just a
   "max-height" cap) so the dialog's own overall height stays constant
   regardless of how many entries exist or how many are expanded, rather
   than visibly growing/shrinking the whole dialog as the user expands or
   collapses individual entries. A short history just leaves blank space
   below it instead -- deliberate, the tradeoff for a dialog that doesn't
   jump around; the list scrolls internally past this height rather than
   growing the dialog past the viewport. */
#svn-history-content {
    height: 65vh;
    overflow-y: auto;
}

/* Stops "--width: 90vw" (set on "#svn-history-dialog" itself, in the markup
   below) from growing past 1620px (90% of a 1800px window) on a very
   wide monitor. Targets "::part(dialog)", the actual visible dialog box
   living in wa-dialog's own shadow DOM, not a plain "max-width" on the
   host element itself -- confirmed for real that the host's own box
   doesn't propagate an ordinary CSS property into the shadow tree the
   way a "--custom-property" does; only "::part()" actually reaches the
   element that "width: var(--width)" is applied to internally. */
#svn-history-dialog::part(dialog) {
    max-width: 1620px;
}

/* "Folder only" toggle: same pure-CSS ":state(checked)" technique as
   "Show folders" above, but opposite polarity -- checked here RESTRICTS
   the view (hides everything but entries touching the browsed folder's
   own path), where "Show folders"' checked state REVEALS more. A plain
   descendant combinator, not "~": unlike "Show folders" (a sibling of
   ".svn-main"), the switch here and ".log-item" are both actual
   descendants of "#svn-history-dialog" itself (the switch via its
   "header-actions" slot, the entries via "#svn-history-content" nested
   inside) -- a sibling combinator wouldn't even match. Entries lacking
   ".log-item-own-change" entirely (e.g. because repo_root was absent
   from this History link -- see svn-log.lua's own render_context.
   own_relative_path) are all hidden once checked, the same class of
   degradation as changed-path links themselves falling back to plain
   unlinked text in that case. */
#svn-history-dialog:has(wa-switch:state(checked)) wa-details.log-item:not(.log-item-own-change) {
    display: none;
}

/* "Folder only" only has any visible effect for a folder's own history --
   every entry in a FILE's history is already an own-change (see
   render_log_item's own comment in svn-log.lua: a file has no
   descendants, so descendant_change can never be set), meaning the rule
   above would never hide anything for one regardless of the switch's own
   state. Hidden entirely rather than left inert, using the same
   ":has()"-reads-a-descendant-affects-a-sibling technique as the rule
   above -- ".svn-log-file" is svn-log.lua's own preamble marking this
   swapped-in response as file-scoped (see its own comment on
   request_href/is_file). */
#svn-history-dialog:has(.svn-log-file) #svn-history-folder-toggle {
    display: none;
}

/* One <wa-details class="log-item"> per History entry (see
   log-item.mustache) -- independent expand/collapse (no shared "name"
   attribute), consistent vertical rhythm across entries via flex+gap
   rather than per-item margins. --log-revision-column is the single
   source of truth for a shared left-indent column, sized to comfortably
   fit a 6-digit revision number -- everything that needs to line up
   underneath the revision badge (".log-revision-slot",
   ".log-message-preview", ".log-body", all below) keys off this one
   value. Deliberately "rem", not "em": different elements using it live
   in different parts of wa-details' own internals (its summary slot vs.
   its default content slot), which can have different computed
   font-sizes -- a real risk, not just caution, confirmed via a real
   browser measurably misaligning two elements that used "em" here
   instead. "rem" is always relative to the root font-size, so every use
   resolves to the identical pixel value regardless of local font-size
   context. */
.svn-log {
    --log-revision-column: 4rem;
    display: flex;
    flex-direction: column;
    gap: var(--wa-space-xs);
}

/* The continuous-scroll sentinel (see log-more.mustache) -- a direct child
   of ".svn-log", so it already inherits the flex-column stacking/gap above.
   Its own layout/centering/muted-text styling is handled entirely by Web
   Awesome utility classes on the markup itself (wa-cluster,
   wa-justify-content-center, wa-color-text-quiet, wa-font-size-s) -- only
   padding is set here, since Web Awesome has no padding/spacing-inset
   utility of its own. Intersecting this element is what triggers the next
   batch's fetch (see its own "hx-trigger"), so it must stay genuinely
   visible/laid-out (not display:none) for IntersectionObserver to ever
   fire on it -- the "htmx-indicator" child (see log-more.mustache) is what
   actually stays invisible until the fetch is in flight, not this element
   itself. */
.svn-log-more {
    padding: var(--wa-space-s);
}

/* Reuses the existing dashed-box style shared with the breadcrumb's own
   "?p=REV" indicator (see ".revision-badge" above), but as a real link
   now -- reset so it doesn't look like a boring blue hyperlink, matching
   this file's own "wa-tree-item a" reset below for the same reason. */
a.revision-badge {
    color: inherit;
    text-decoration: none;
}

/* Reserves the fixed-width indent column; the badge itself (see
   ".revision-badge" above) stays tight around its own digits and just
   sits left-aligned inside this wrapper, so shorter revisions leave
   visible empty space to their right rather than stretching the badge's
   own box to match. */
.log-revision-slot {
    display: inline-block;
    min-width: var(--log-revision-column);
}

/* The copy/move source indicator's own revision badge (see
   log-item.mustache's ".copy-from") -- same square dashed-box style, but
   smaller, and never wrapped in ".log-revision-slot", since it sits
   inline mid-sentence rather than anchoring a layout column. */
.log-item .revision-badge-small {
    font-size: 0.75em;
}

/* Two summary layouts depending on wa-page's own "view" attribute
   (https://webawesome.com/docs/components/page -- the same desktop/mobile
   split already used above for the header/navigation, reflecting actual
   available layout width rather than a raw viewport media query). This
   unqualified rule is the mobile/fallback layout: meta row, then the
   message on its own row underneath -- there isn't reliably enough width
   for a two-column layout at that size. "wa-page[view='desktop']" below
   switches to a single row instead, meta and message side by side. */
.log-summary {
    display: flex;
    flex-direction: column;
    gap: var(--wa-space-2xs);
    /* wa-details' own shadow-DOM header doesn't stretch this slotted div to
       the header's full available width -- left implicit, it's shrink-to-
       fit around its own content instead, and that shrink-to-fit width
       varies slightly per entry. Harmless in the column layout above, but
       breaks the desktop row below: ".log-summary-meta"'s own flex-grow
       needs real leftover row space to absorb, which a shrink-to-fit
       container -- sized to exactly fit its children, with nothing left
       over -- never has any of. */
    width: 100%;
}

wa-page[view='desktop'] .log-summary {
    flex-direction: row;
    align-items: baseline;
    gap: var(--wa-space-m);
}

.log-summary-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--wa-space-s);
}

/* Not sized off the author text, for the same reason --log-revision-column
   above is fixed: author is free text that can be anything from "bob" to
   a full email address, so leaving this column's width to its content
   would make every entry's message start position only as reliable as
   that guess. The "%" term in the clamp() below ties this column's size
   to the dialog's own real width instead (a percentage flex-basis
   resolves against ".log-summary"'s own rendered content-box width,
   which already reflects the dialog's "--width: 90vw" plus any padding
   along the way); the min/max rem bounds keep it legible on a dialog
   only just past the mobile breakpoint, and cap how wide it grows on a
   very large one -- 34rem, sized against a real email address (~28
   characters, ~267px of text alone measured in Linux Chromium's default
   sans-serif fallback, the widest of the browser/OS combinations
   checked -- macOS's system-ui resolves narrower, so 32rem was enough
   there but fell 11px short of fitting on Linux's wider rendering),
   so a realistic author value can actually fit rather than always
   ellipsis-truncating regardless of how much space the dialog has to
   spare. flex-shrink:1 and min-width:0
   share any space deficit with ".log-message-preview" below (also
   shrinkable) via normal flex distribution, rather than concentrating it
   entirely on one column -- ".log-author strong" below is the actual
   ellipsis-truncation target and carries its own min-width:0 for the
   same shrink-below-automatic-minimum reason. flex-grow:1
   (".log-message-preview" stays grow:0) means this column, not a dead
   gap, absorbs any leftover row space: the dialog's own width is
   viewport-relative and uncapped, so a wide window can leave more row
   space than either column's preferred size needs, and without
   something claiming it that surplus just becomes empty space between
   the two columns. max-width repeats the clamp()'s own 34rem cap as a
   separate property because flex-grow can push a flex item past its
   flex-basis (all clamp() actually constrains) with nothing else
   stopping it -- clamp()'s max argument bounds the *starting* size, not
   continued growth. */
wa-page[view='desktop'] .log-summary-meta {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: clamp(20rem, 32%, 34rem);
    max-width: 34rem;
    min-width: 0;
    flex-wrap: nowrap;
}

.log-author {
    display: inline-flex;
    align-items: center;
    gap: var(--wa-space-2xs);
}

wa-page[view='desktop'] .log-author {
    flex: 1 1 auto;
    min-width: 0;
}

/* The actual truncation target -- ellipsis goes on the text itself, not
   the flex row that also contains the icon, since a flex container with
   overflow:hidden doesn't truncate its children's rendered text on its
   own. */
wa-page[view='desktop'] .log-author strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
}

/* The always-visible collapsed preview and the expanded full message both
   carry "wa-color-text-quiet" directly in their markup (see log-item.mustache)
   -- sharing this same font/color treatment is what makes the expanded one
   read as "the same text, just fully shown" rather than a distinct code
   block. white-space is deliberately NOT shared (see each rule below) --
   ".log-message-full" needs "pre-wrap", not "pre-line", to avoid a real
   fidelity regression. */

/* Mobile: on its own row below ".log-summary-meta" (revision/date/
   author), indented to the exact same fixed column ".log-body" below
   also uses -- not positioned by flowing after (or right-aligning past)
   the author field, for the same reason ".log-summary-meta" above isn't
   sized off the author text on desktop. Desktop (see
   "wa-page[view='desktop']" below) instead shares a row with that meta
   column, sized the same percentage-of-the-row-plus-clamp() way so it
   scales with the dialog. Deliberately flex-grow:0, unlike meta -- this
   is prose, and a two-line clamp gets harder to read past a certain line
   length, so once it reaches its own clamp() max it should stop growing
   rather than keep claiming space; meta absorbs any further leftover
   instead (see its own flex-grow:1 below), which also naturally leaves
   this column at the row's right edge with no push needed to put it
   there. Shrinkable (flex-shrink:1) for the same reason ".log-summary-
   meta" above has no hard min-width: a rigid column forces the *other*
   one to absorb 100% of any space deficit alone once its own clamp()
   floor is reached, defeating the smooth, shared scaling clamp() is
   supposed to provide across the whole row. Two-line clamp: a
   -webkit-box, not a fade-gradient overlay -- this app targets evergreen
   Chromium/Firefox/Safari, which all implement these (nominally
   WebKit-prefixed, now universal) properties, simpler and more robust
   than a gradient mask over wa-details' own light/dark theme tokens, with
   no separate overflow-detection needed either. Hidden entirely once the
   entry is expanded (see ".log-item[open]" below) -- the full message
   takes over instead, so the same text is never shown twice at once.
   white-space: pre-line (not the full-fidelity "pre-wrap"
   ".log-message-full" uses below) preserves embedded line breaks but
   collapses runs of multiple spaces/tabs -- an acceptable trade-off for
   an already-truncated 2-line summary, avoiding the wider, more code-like
   look "pre-wrap" gives a message with intentional multi-space
   formatting. */
.log-message-preview {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    white-space: pre-line;
    /* Mobile's own reading-width cap -- overridden below on desktop to
       36rem, matching that layout's own clamp() max, rather than just
       inheriting this smaller value and silently capping the desktop
       column below what its own clamp() intends. */
    max-width: 28rem;
}

.log-item[open] .log-message-preview {
    display: none;
}

wa-page[view='desktop'] .log-message-preview {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: clamp(16rem, 40%, 36rem);
    max-width: 36rem;
    min-width: 0;
}

/* The full commit message, revealed once expanded, indented to match
   ".log-body" below. Uses Web Awesome's own "wa-flank" utility (see
   log-item.mustache: this div's two direct children are the comment icon,
   then the message text) so a wrapped message stays in its own column to
   the right of the icon instead of its continuation lines sliding back
   underneath it -- ordinary inline content (icon + text in one flow)
   can't do this; wrapped lines of plain inline content always return to
   the container's own left edge, not the position just past the icon.
   white-space: pre-wrap (not ".log-message-preview"'s own "pre-line")
   preserves runs of multiple spaces/tabs as well as newlines -- this is
   the "show me everything, exactly as written" view, so it keeps full
   fidelity for a message using intentional multi-space formatting (an
   indented list, an ASCII-aligned snippet, etc.), which "pre-line" alone
   would otherwise silently collapse. Height-capped at 12rem -- roomy
   enough for most real commit messages to read in full without
   scrolling, while still bounding a pathological multi-hundred-line
   message to a fixed, independently scrollable box instead of growing
   the whole dialog past the viewport. */
.log-message-full {
    white-space: pre-wrap;
    margin: 0 0 var(--wa-space-s);
    max-height: 12rem;
    overflow-y: auto;
    /* wa-flank centers its two children by default, which centers the
       icon against the full height of a wrapped multi-line message
       instead of sitting next to its first line. baseline lines the icon
       up with the text's own first-line baseline regardless of how many
       lines the message wraps to -- flex-start looked wrong too: it pins
       the icon to the very top of the line box, above the glyphs'
       cap-height, so it read as floating above the text rather than
       beside it. */
    align-items: baseline;
    /* wa-flank's own default gap is wider than ".changed-paths li" below
       sets explicitly, which left the message text starting further from
       its icon than each changed-path's text does. Matching it here keeps
       the icon-to-text gap identical in both places. */
    gap: var(--wa-space-2xs);
}

/* Dims the comment icon (rather than showing an empty italic span next to
   a full-strength icon, which reads as "this entry is broken") when a
   revision genuinely has no log message. */
.log-message-empty wa-icon {
    opacity: 0.4;
}

/* ".log-message-preview" (above) and this both indent to the exact same
   fixed column by default -- past the revision column plus the row's own
   gap -- so the collapsed and expanded states share one consistent left
   edge, kept in one shared rule rather than repeating the same calc()
   twice. Both view-specific overrides below drop this indent back to 0
   again on their own terms: desktop, because ".log-message-preview" is a
   sibling of the meta row rather than indented underneath it there;
   mobile, to reclaim the column's width on a screen where it's scarce,
   for both the collapsed preview and the expanded body alike.
   --flank-size is Web Awesome's own "wa-flank" utility custom property
   (https://webawesome.com/docs/utilities/flank/), controlling how wide
   the fixed/natural-size first child of a ".wa-flank" is -- set once
   here, it inherits down to both ".log-message-full" and every
   ".changed-paths li" below (both use ".wa-flank" with an icon as their
   first child), so the message icon and every changed-path icon reserve
   the exact same column width and land in the same vertical line,
   regardless of each icon's own glyph metrics. */
.log-message-preview,
.log-body {
    margin-left: calc(var(--log-revision-column) + var(--wa-space-s));
}

.log-body {
    --flank-size: 1.5rem;
}

wa-page[view='mobile'] .log-message-preview,
wa-page[view='mobile'] .log-body {
    margin-left: 0;
}

.changed-paths {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--wa-space-2xs);
}

/* Each <li> is itself a "wa-flank" (see log-item.mustache: its own two
   direct children are the action icon, then a <span> wrapping the path
   link and any copy-from indicator) -- own "display" deliberately left
   unset here so wa-flank's own utility CSS (loaded earlier, in <head>)
   supplies it uncontested; redeclaring "display: flex" on this same
   selector would win the cascade (this stylesheet loads after Web
   Awesome's own) and silently break the flank layout. --flank-size (see
   ".log-body" above) is what actually aligns this icon with the log
   message's own icon above it -- but only once margin is reset here too:
   Web Awesome's own base stylesheet gives every <li> a default
   margin-inline-start (18px), a general typography reset with no
   awareness this specific <li> is a custom flex layout, not a bulleted
   list item -- left unreset, it pushed this icon further right than
   ".log-message-full"'s own icon, out of alignment despite both sharing
   the same --flank-size. */
.changed-paths li {
    margin: 0;
    gap: var(--wa-space-2xs);
    align-items: baseline;
}

.changed-paths a {
    color: inherit;
}

/* A copy/move's own source indicator, inline after the destination path
   -- no arrow icon (read as confusing), just "from <path> <small revision
   badge>". */
.copy-from {
    display: inline-flex;
    align-items: center;
    gap: var(--wa-space-2xs);
}

/* The navigation tree only ever browses folders -- files (and the ".."
   entry, which is superseded by the header's "Up" button) fetched into it
   via htmx are hidden here regardless of how deeply they end up nested. */
wa-tree.svn-nav .file,
wa-tree.svn-nav .updir {
    display: none;
}

/* SVN_INDEX_HIDE_DIR-matched entries (see ENTRY_CONTEXT_BUILDERS.dir in
   svn-index.lua) are hidden in the nav tree specifically -- the main
   content panel always shows every entry mod_dav_svn returns regardless of
   this setting. Revealed by the same "Show folders" switch that already
   reveals directories in the main panel (same ":not(:state(checked))"
   condition as the ".svn-main .dir" rule above): one switch for "show
   everything this UI otherwise hides by default", nav and main alike. */
#svn-subheader:has(wa-switch:not(:state(checked))) ~ nav[slot="navigation"] wa-tree.svn-nav .navhidden {
    display: none;
}

/* Navigation is driven off wa-selection-change (see dir.mustache's own
   hx-trigger, and each <wa-tree>'s own hx-on:wa-selection-change below,
   which synthesizes a real click on a selected leaf's plain <a> for
   file/repo entries), not off where in the row a click lands -- the label
   itself just shouldn't look like a hyperlink. */
wa-tree-item a {
    color: inherit;
    text-decoration: none;
}

/* Hovering anywhere in a file row underlines its own name link, matching
   what a click anywhere in that same dead space already does (see the
   comment above): resolves to a synthesized click on this exact link (via
   wa-selection-change's own ":scope > a[href]" query). Excluded whenever
   ".file-actions" (the History icon's own group, further down) is itself
   being hovered -- that area does NOT act as the file link (its own icon
   calls stopPropagation precisely to prevent that, see file.mustache),
   so its hover state shouldn't imply otherwise. ":has()" reads a
   descendant's own hover state from the ancestor selector, the same
   technique the "Folder only" rules elsewhere in this file already use. */
wa-tree-item.file:hover:not(:has(.file-actions:hover)) > a {
    text-decoration: underline;
}

/* wa-tree-item's own unnamed (default) slot -- where a file row's two
   direct children (the name link, ".file-actions" below) land -- is
   itself a flex container, exposed for exactly this kind of external
   styling as "::part(label)" (confirmed against Web Awesome's own
   tree-item source). It doesn't grow to fill the row by default (only
   as wide as its own content) -- "flex: 1" makes it fill the row's full
   available width instead, and "justify-content: space-between" then
   pins ".file-actions" to a consistent position at the row's right edge
   regardless of how long the filename is, the equivalent for a file row
   of what ".log-revision-slot" (above) does for log entries: something
   always lining up at the same horizontal position instead of drifting
   with variable-length content next to it. "min-width: 0" is the
   standard fix for a flex item that would otherwise refuse to shrink
   below its own content's natural width -- without it, a long filename
   could push ".file-actions" out past the row's own right edge instead
   of the filename eliding/wrapping. Scoped to "wa-tree-item.file" only
   (not dir/repo/updir, which have no ".file-actions" group at all). */
wa-tree-item.file::part(label) {
    flex: 1;
    min-width: 0;
    justify-content: space-between;
}

/* ".file-actions" (file.mustache) groups this file row's own per-file
   action icons -- today just "History", a home for any more added later
   -- kept visually apart from the file's own name/link via the
   space-between above rather than an inline margin next to the name.
   Its own flex-row-with-gap layout is the existing "wa-cluster wa-gap-2xs"
   utility classes (see file.mustache), not bespoke CSS here -- no rule
   of its own needed for that. */

/* Per-file "History" icon (see file.mustache) -- a second, independent
   <a href hx-action hx-method="REPORT" hx-trigger="click"> alongside the
   file's own download link, same pattern as page-header.mustache's own
   "History" link, just scoped to this one file instead of the browsed
   directory. Muted until hovered/focused so it doesn't compete visually
   with the file's own name -- ".wa-color-text-quiet" isn't reachable here
   (this file has no such class name available inline), so the same muted
   tone is hand-matched via opacity instead. */
.file-history-action {
    opacity: 0.55;
}
.file-history-action:hover,
.file-history-action:focus-visible {
    opacity: 1;
}
</style>
{{{page-head-end}}}
</head>
<body>
<wa-page class="wa-font-size-s">
{{{page-skip-to-content}}}
{{{page-banner}}}
{{{page-header}}}
{{{page-subheader}}}
{{{page-navigation-header}}}
<!-- Neither dir.mustache's <span hx-get> nor file/repo.mustache's plain
     <a href> ever activates via wa-tree's own selecting-click-anywhere-in-
     the-row or keyboard Enter/Space: wa-tree's keydown handler drives
     selection by mutating state, never firing a native click, and a
     dead-zone click (indentation/chevron area, or empty row space) never
     lands on either child element. hx-on:wa-selection-change here (not on
     the item itself) is deliberate: Web Awesome's own wa-tree dispatches
     this event on itself, never on the individual wa-tree-item (confirmed
     against wa-tree's own source, tree.ts's selectItem()) -- a listener on
     the item would sit on a descendant of where the event actually fires
     and would never see it, since bubbling only flows outward to
     ancestors, never down into descendants. One shared handler covers
     both entry kinds: a synthesized click on dir's span re-fires its own
     existing hx-get/hx-target/hx-swap/hx-select/hx-select-oob (no
     double-fire -- dir.mustache's own "click[this.parentElement.selected]"
     filter only matches once .selected is already true, which is only
     ever the case for this synthetic replay or a genuine reselect, never
     the original click that caused the selection in the first place); a
     synthesized click on file/repo's anchor is real browser navigation,
     sometimes a file download, that no ajax swap could stand in for.
     Scoped to selection.forEach(...) rather than a single item, since
     single-selection mode still reports an array. -->
<nav slot="navigation">
<wa-tree class="svn-nav" hx-get="{{{nav_root_path}}}" hx-trigger="load" hx-target="this" hx-swap="innerHTML" hx-select=".svn-index > wa-tree-item" hx-on:wa-selection-change="event.detail.selection.forEach(item => item.querySelector(':scope > span[hx-get], :scope > a[href]')?.click())">
</wa-tree>
</nav>
{{{page-navigation-footer}}}
{{{page-main-header}}}
<div class="svn-main">
<wa-tree class="svn-index" id="svn-index" hx-on:wa-selection-change="event.detail.selection.forEach(item => item.querySelector(':scope > span[hx-get], :scope > a[href]')?.click())">
{{{svn_index}}}</wa-tree>
</div>
{{{page-main-footer}}}
{{{page-aside}}}
{{{page-footer}}}
<!-- Unslotted, so it lands in wa-page's default slot alongside ".svn-main"
     -- deliberately a real descendant of <wa-page>, not a sibling after it,
     so the "wa-page[view='desktop']"/"wa-page[view='mobile']" rules above
     (see ".log-summary" etc.) actually match its contents. wa-dialog
     renders its own internal native <dialog>, which paints in the
     browser's top layer regardless of DOM ancestry, so nesting it here
     doesn't affect its overlay/positioning behavior at all. -->
<wa-dialog id="svn-history-dialog" label="History" light-dismiss style="--width: 90vw;">
<div class="wa-cluster wa-gap-s" slot="header-actions">
<wa-switch id="svn-history-folder-toggle" class="wa-font-size-s">Folder only</wa-switch>
<wa-button id="svn-history-expand-toggle" appearance="plain" size="s">Expand all</wa-button>
</div>
<div id="svn-history-content"{{#history_active}} hx-action="{{{request_href}}}{{{history_target}}}{{{history_query_suffix}}}" hx-method="REPORT" hx-trigger="load"{{/history_active}}></div>
</wa-dialog>
</wa-page>
</body>
</html>
