<wa-tree-item class="file"><a href="{{{hx_href}}}" tabindex="-1" draggable="false" hx-on:click="event.stopPropagation()">{{#icon_badge}}<span class="icon-badged">{{/icon_badge}}<wa-icon name="{{{icon}}}" variant="regular"></wa-icon>{{#icon_badge}}<wa-icon name="{{{icon_badge}}}" variant="solid"></wa-icon></span>{{/icon_badge}} {{{name}}}</a><div class="file-actions wa-cluster wa-gap-2xs"><span id="lock-{{{path_id}}}" class="lock-indicator"></span>{{#repo_root}}<a class="file-history-action" href="{{{request_href}}}{{{href_no_query}}}{{{history_query_suffix}}}" hx-action="{{{request_href}}}{{{href_no_query}}}{{{history_query_suffix}}}" hx-method="REPORT" hx-target="#svn-history-content" hx-swap="innerHTML" hx-select="" hx-select-oob="" hx-trigger="click" hx-on:click="event.stopPropagation()" title="History" aria-label="History for {{{name}}}"><wa-icon name="clock-rotate-left"></wa-icon></a>{{/repo_root}}</div></wa-tree-item>
