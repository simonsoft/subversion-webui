<wa-tree-item class="file"><a href="{{{hx_href}}}"><wa-icon name="file" variant="regular"></wa-icon> {{{name}}}</a><div class="file-actions wa-cluster wa-gap-2xs"><span id="lock-{{{path_id}}}" class="lock-indicator"></span>{{#repo_root}}<a class="file-history-action" href="{{{request_href}}}{{{href_no_query}}}{{{history_query_suffix}}}" hx-action="{{{request_href}}}{{{href_no_query}}}{{{history_query_suffix}}}" hx-method="REPORT" hx-target="#svn-history-content" hx-swap="innerHTML" hx-trigger="click" hx-on:click="event.stopPropagation()" title="History" aria-label="History for {{{name}}}"><wa-icon name="clock-rotate-left"></wa-icon></a>{{/repo_root}}</div></wa-tree-item>
